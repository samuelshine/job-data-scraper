# JobPulse Environment Variables
# Copy to .env and fill in your values

# Server
PORT=8080
DATABASE_PATH=jobpulse.db

# Auth
JWT_SECRET=change-me-in-production

# CORS
CORS_ORIGINS=http://localhost:4321

# Source fan-out worker pool
SOURCE_FETCH_WORKERS=4

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=1m
ADMIN_RATE_LIMIT_REQUESTS=10
ADMIN_RATE_LIMIT_WINDOW=1m

# Job Sources (optional — app works with seed data if unset)
JSEARCH_API_KEY=your-rapidapi-key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
